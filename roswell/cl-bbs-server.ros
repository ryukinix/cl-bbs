#!/bin/sh
#|-*- mode:lisp -*-|#
#|
exec ros -Q -- $0 "$@"
|#
(progn ;;init forms
  (ros:ensure-asdf)
  (let ((setup (or (probe-file (merge-pathnames ".qlot/setup.lisp" *default-pathname-defaults*))
                   (and *load-truename* (probe-file (merge-pathnames "../.qlot/setup.lisp" *load-truename*))))))
    (if setup
        (load setup)
        #+quicklisp(ql:quickload '() :silent t)))
  )

(defpackage :ros.script.cl-bbs-server.3908865487
  (:use :cl))
(in-package :ros.script.cl-bbs-server.3908865487)

(ql:quickload :cl-bbs/server)

(defun main (&rest argv)
  (declare (ignorable argv))
  (let* ((port (or (and argv (parse-integer (car argv) :junk-allowed t))
                  (parse-integer (or (uiop:getenv "PORT") "8222") :junk-allowed t)
                  8222))
         (app (lack:builder
               (:static :path "/static/"
                        :root (pathname (or (uiop:getenv "SBBS_STATIC_DIR")
                                            (merge-pathnames "src/static/" (asdf:system-source-directory :cl-bbs/server)))))
               (lambda (env) (cl-bbs/handlers:handle-request env)))))

    (format t "Starting cl-bbs on port ~a~%" port)
    (clack:clackup app :address "0.0.0.0" :port port :server :hunchentoot :use-thread nil)))